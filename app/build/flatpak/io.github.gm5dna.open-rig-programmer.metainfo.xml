<component type="desktop-application">
  <id>io.github.gm5dna.open-rig-programmer</id>
  <name>Open Rig Programmer</name>
  <summary>Radio memory-channel programmer</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      Reads and writes memory channels on Yaesu, Icom and Kenwood radios
      over a serial CAT connection. The FT-710 is verified against real
      hardware; other supported models read, and write only once
      switched on for that radio.
    </p>
    <p>
      Memory-channel programmer for Yaesu, Icom and Kenwood transceivers:
      view and edit channels in a spreadsheet-like grid, import/export
      CSV and CHIRP files, and read or apply radio settings menus, all
      over the same serial CAT link the manufacturer's own software
      uses.
    </p>
  </description>
  <launchable type="desktop-id">io.github.gm5dna.open-rig-programmer.desktop</launchable>
  <url type="homepage">https://github.com/gm5dna/open-rig-programmer</url>
